# ==========================================
# AI Assignment Research Agent - Configuration
# ==========================================

# Google Gemini API Key: Required for AI literature synthesis and report drafting.
# Obtain a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your_actual_gemini_api_key_here"

# Database Configuration:
# Default is SQLite for straightforward local development.
# For production PostgreSQL: postgresql://user:password@localhost:5432/research_db
DATABASE_URL="sqlite:///./research_agent.db"

# FastAPI Backend Port
PORT=8000

# Environment mode: development / production
ENVIRONMENT="development"
